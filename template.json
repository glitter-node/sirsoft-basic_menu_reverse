{
    "identifier": "sirsoft-basic_menu_reverse",
    "vendor": "Glitter.kr",
    "name": {
        "ko": "Basic Menu Reverse",
        "en": "Basic Menu Reverse"
    },
    "version": "1.0.1",
    "license": "MIT",
    "description": {
        "ko": "그누보드 7 기본 메뉴 반전 사용자 템플릿",
        "en": "GnuBoard 7 Default Menu Inversion User Template"
    },
    "type": "user",
    "locales": [
        "ko",
        "en"
    ],
    "author": {
        "name": "Glitter.kr"
    },
    "g7_version": ">=7.0.11",
    "dependencies": {
        "modules": {
            "sirsoft-board": ">=1.0.0",
            "sirsoft-ecommerce": ">=1.1.0",
            "sirsoft-page": ">=1.1.0"
        },
        "plugins": {
            "sirsoft-daum_postcode": ">=1.0.0"
        }
    },
    "assets": {
        "css": [
            "dist/css/components.css"
        ],
        "js": [
            "dist/js/components.iife.js"
        ],
        "fonts": [],
        "images": []
    },
    "components": {
        "basic": [
            "a", "button", "checkbox", "div", "form", "h1", "h2", "h3", "h4", "hr",
            "icon", "img", "input", "label", "li", "nav", "p", "section", "select",
            "span", "svg", "table", "tbody", "td", "textarea", "th", "thead", "tr", "ul"
        ],
        "composite": [
            "header", "footer", "mobile-nav", "product-card", "rich-text-editor",
            "image-gallery", "quantity-selector", "post-reactions", "social-login-buttons",
            "file-uploader", "card", "modal", "toast", "pagination", "stat-card",
            "status-badge", "tab-navigation", "empty-state", "loading-spinner",
            "breadcrumb", "search-bar", "dropdown"
        ],
        "layout": ["container", "flex", "grid", "section"]
    },
    "error_config": {
        "layouts": {
            "401": "errors/401",
            "403": "errors/403",
            "404": "errors/404",
            "500": "errors/500",
            "503": "errors/503",
            "maintenance": "errors/maintenance"
        }
    },
    "features": {
        "dark_mode": true,
        "responsive": true,
        "multi_language": true,
        "multi_currency": true
    },
    "externals": [
        {
            "id": "fontawesome",
            "type": "style",
            "asset": "vendor/font-awesome/6.4.0/css/all.inlined.css"
        },
        {
            "id": "pretendard",
            "type": "webfont",
            "asset": "vendor/pretendard/1.3.9/pretendard-variable.css"
        }
    ]
}
